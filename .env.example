# =============================================================================
# VIN OCR Pipeline - Environment Configuration
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# All variables are optional; the pipeline falls back to the defaults shown.
# =============================================================================


# -----------------------------------------------------------------------------
# DagsHub / DVC remote credentials
# -----------------------------------------------------------------------------
# These replace the previously committed .dvc/config.local file.
# Generate tokens at: https://dagshub.com/user/settings/tokens
#
# DVC reads S3-compatible remotes via the standard AWS variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DagsHub API token (used by dagshub client / MLflow integration)
DAGSHUB_USER_TOKEN=
DAGSHUB_REPO_OWNER=Thundastormgod
DAGSHUB_REPO_NAME=paddleocr_vin_pipeline


# -----------------------------------------------------------------------------
# Preprocessing
# -----------------------------------------------------------------------------
# CLAHE contrast limit (higher = more aggressive contrast enhancement)
VIN_CLAHE_CLIP_LIMIT=2.0
# Max image edge in pixels before downscaling (prevents OOM)
VIN_MAX_IMAGE_DIM=4096
# One of: none | standard | engraved | low_contrast | adaptive | aggressive
VIN_PREPROCESS_MODE=engraved


# -----------------------------------------------------------------------------
# OCR engine
# -----------------------------------------------------------------------------
# Detection box threshold (lower = catches fainter engravings)
VIN_DET_BOX_THRESH=0.3
# Recognition score threshold
VIN_REC_THRESH=0.3
# Use CUDA GPU for PaddleOCR (true/false). Apple MPS is NOT supported by Paddle.
VIN_USE_GPU=false


# -----------------------------------------------------------------------------
# Training
# -----------------------------------------------------------------------------
VIN_EPOCHS=50
VIN_BATCH_SIZE=8
VIN_LEARNING_RATE=0.0001

VIN_FINETUNE_EPOCHS=100
VIN_FINETUNE_BATCH_SIZE=64
VIN_FINETUNE_LR=0.0005

# Augmentation: images per class below this count get augmented
VIN_AUGMENTATION_THRESHOLD=50
VIN_MIN_AUGMENTATION_FACTOR=5
VIN_MAX_AUGMENTATION_FACTOR=50


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
VIN_LOG_LEVEL=INFO
# Optional file to tee logs into (leave blank for stdout only)
VIN_LOG_FILE=
