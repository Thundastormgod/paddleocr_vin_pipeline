# =============================================================================
# SECRETS - never commit these
# =============================================================================
# Environment files
.env
.env.*
!.env.example

# DVC / DagsHub credentials (config.local holds access keys)
.dvc/config.local
.dvc/tmp/
.dvc/cache/

# SSH / signing keys
keyjson
keyjson.pub
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
*_ed25519.pub

# Cloud provider credentials
.aws/
credentials.json
service-account*.json
gcp-*.json

# Streamlit persisted session state (contains absolute local paths)
.streamlit_state.json
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# Development notes and scratch files (not tracked)
dev/

# Cloned repositories (not tracked - clone locally)
PaddleOCR/

# Model outputs and training artifacts (large files - use LFS for weights)
output/
training_output/
finetune_data/
*.pdmodel
*.pdiparams
*.onnx
*.pt
*.bin
*.safetensors

# Data folders (managed by DVC)
data/
dagshub_data/
dataset/

# HuggingFace cache
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Results (keep sample, ignore detailed)
results/multi_eval/
results/detailed_metrics.json
results/experiment_summary.json

# Experiment tracking - the default local MLflow store.
# Run records (metrics, params, diffs, provenance) live in mlflow.db, with
# artifacts under mlartifacts/. These are per-machine run records, not source:
# committing them would bloat the repo and recreate the situation the audit
# found in results/, where JSON result files were tracked in git with no writer
# left in the tree to explain them. Share runs through a tracking server
# (MLFLOW_TRACKING_URI), not through git.
mlflow.db
mlflow.db-journal
mlartifacts/
mlruns/
